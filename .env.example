# MikroTik endpoint
# Option A: full URL to kid-control endpoint
MIKROTIK_KID_CONTROL_URL=http://192.168.88.254/rest/ip/kid-control

# Option B: base URL (used only if MIKROTIK_KID_CONTROL_URL is empty)
MIKROTIK_BASE_URL=http://192.168.88.254

# Credentials (do not commit real values)
MIKROTIK_USER=<user>
MIKROTIK_PASSWORD=<password>

# Optional legacy auth header override
# BASIC_AUTH=Basic <base64(user:pass)>

# Runtime paths inside proxy container
DB_PATH=/data/kid-control-state.db
LIMITS_CONFIG_PATH=/app/config/kid-access-config.json

# Container timezone for logs/runtime (should match config timezone)
TZ=Europe/Moscow
