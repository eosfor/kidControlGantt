# MikroTik endpoint
MIKROTIK_KID_CONTROL_URL=http://192.168.88.254/rest/ip/kid-control
# fallback if MIKROTIK_KID_CONTROL_URL is empty
MIKROTIK_BASE_URL=http://192.168.88.254

# Credentials (do not commit real values)
MIKROTIK_USER=<user>
MIKROTIK_PASSWORD=<password>
# optional override
# BASIC_AUTH=Basic <base64(user:pass)>

# Runtime paths inside container
DB_PATH=/data/kid-control-state.db
LIMITS_CONFIG_PATH=/app/config/kid-access-config.json
APP_TIMEZONE=America/Los_Angeles

# Optional runtime tuning
CONFIG_CACHE_TTL_MS=5000
SWEEP_INTERVAL_SECONDS=10

# Optional email notifications (leave empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
